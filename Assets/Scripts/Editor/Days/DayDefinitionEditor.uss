.day-inspector {
    padding-left: 4px;
    padding-right: 4px;
    padding-bottom: 10px;
}

.day-header,
.pool-header {
    margin-bottom: 8px;
    padding: 10px;
    background-color: rgb(35, 42, 51);
    border-radius: 5px;
}

.day-title {
    color: rgb(239, 242, 245);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.population-summary {
    color: rgb(220, 226, 232);
    font-size: 13px;
    margin-bottom: 6px;
    white-space: normal;
}

.feature-summary {
    color: rgb(143, 198, 192);
    white-space: normal;
}

.open-window-button {
    height: 28px;
    margin-top: 4px;
    margin-bottom: 8px;
}

.day-section {
    margin-top: 2px;
    margin-bottom: 3px;
    padding-top: 2px;
    padding-bottom: 4px;
}

.validation-container {
    margin-top: 10px;
}

.validation-title {
    -unity-font-style: bold;
    margin-bottom: 4px;
}
